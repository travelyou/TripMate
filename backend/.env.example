# ============================================
# 後端環境變數範例文件
# ============================================
# 設置步驟：
# 1. 更改此文件檔名為 .env
# 2. 填入 discord 上面給你的密碼到下面的 DB_PASSWORD
# 3. 不要將 .env 文件上傳到 GitHub！
# ============================================

DB_HOST=db.lxoghtipisvzsnprlxrb.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=填入Supabase資料庫密碼

# 伺服器配置
PORT=3000

# 環境變數 development: 開發環境
NODE_ENV=development

# Firebase Admin SDK（
FIREBASE_PROJECT_ID=travel-you-f4bca

# ============================================
# 測試連接
# ============================================
# 設置完成後，執行以下步驟測試：
# 1. cd 切換到 backend 資料夾執行：npm run dev
# 2. 在瀏覽器測試：http://localhost:3000/api/test-db
# 3. 應該看到：{"message":"資料庫連接成功！","timestamp":"..."}
# ============================================

# ============================================
# 資料庫連接設定(在太元帳號那邊)
# ============================================
# 資料庫連接配置（Supabase 雲端資料庫）
# 所有團隊成員共用同一個 Supabase 資料庫
# 
# 獲取連接資訊的方法：
# 1. 登入 Supabase: https://supabase.com
# 2. 進入專案 → Project Settings → Database
# 3. 在 "Connection string" 區塊選擇 "URI" 標籤
# 4. 複製連接字串，格式：postgresql://postgres:[PASSWORD]@db.xxxxx.supabase.co:5432/postgres
# 5. 從連接字串中提取各部分資訊填入下方